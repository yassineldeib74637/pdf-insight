# Frontend (public, baked into the build). URL of the Supabase Edge Function.
VITE_API_URL=https://<project-ref>.supabase.co/functions/v1/analyze
# Supabase anon (publishable) key - safe to expose, only used to call the function.
VITE_SUPABASE_ANON_KEY=<publishable-key>

# Backend secrets (set in Supabase: Edge Functions -> Secrets). NEVER commit real values.
# GEMINI_API_KEY=<your-gemini-key>
# ALLOWED_ORIGIN=https://<user>.github.io
